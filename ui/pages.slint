// ================================================================== 8 Sistem

/// The Weather page's body is empty: its "Weather bar" switch is the first row of the
/// inspector below, "Other headphones" is the Headphones page's first row, and "Microphone /
/// Camera" moved to the System Events page.
export component SystemBody inherits VerticalLayout {
    alignment: start;
}

/// The weather's city: a box that searches Open-Meteo on Enter, with up to five places under
/// it; once one is picked, the city and a clear button.
component CityPicker inherits VerticalLayout {
    property <bool> picked: Store.city.name != "";
    // Still editable with the clock and the stack both off, only dimmed.
    opacity: Store.idle-clock || Store.weather-in-stack ? 1 : 0.4;
    IRow {
        label: @tr("City");
        note: root.picked ? "" : Store.city-search-state == 1 ? @tr("Searching…") : Store.city-search-state == 3 ? @tr("Connection failed")
            : Store.city-search-state == 2 && Store.city-results.length == 0 ? @tr("Not found") : Store.city-search-state == 2 ? @tr("Select one") : @tr("Type name, press Enter");
        if root.picked: HorizontalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 5px;
                Text {
                    max-width: 120px;
                    text: Store.city.name;
                    font-size: 14px;
                    font-weight: 500;
                    color: Theme.strong;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    max-width: 66px;
                    text: "· " + Store.city.country;
                    font-size: 14px;
                    color: Theme.text2;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            IconButton {
                glyph: "\u{E711}";
                clicked => {
                    Store.city = { name: "", country: "", lat: "", lon: "" };
                    Store.city-search("");
                    Ui.changed();
                }
            }
        }
        if !root.picked: Rectangle {
            width: 140px;
            height: 30px;
            border-radius: 8px;
            background: Theme.field;
            border-width: 1px;
            border-color: input.has-focus ? Theme.acc : hover.has-hover ? Theme.text3 : Theme.field-edge;
            hover := TouchArea {
                mouse-cursor: text;
                clicked => { input.focus(); }
            }
            Icon {
                x: 9px;
                width: 12px;
                height: parent.height;
                glyph: "\u{E721}";
                size: 11px;
                color: Theme.text2;
            }
            if input.text == "": Text {
                x: 27px;
                width: parent.width - 37px;
                height: parent.height;
                text: @tr("New York, London…");
                font-size: 13.5px;
                color: Theme.text3;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 27px;
                width: parent.width - 37px;
                height: parent.height;
                font-size: 13.5px;
                color: Theme.strong;
                vertical-alignment: center;
                single-line: true;
                accepted => { Store.city-search(self.text); }
                edited => {
                    if self.text == "" {
                        Store.city-search("");
                    }
                }
            }
        }
    }
    // The places found, best first; a row's hover reaches into the section's margin.
    if !root.picked: VerticalLayout {
        for c in Store.city-results: Rectangle {
            height: 32px;
            Rectangle {
                x: -10px;
                width: parent.width + 20px;
                border-radius: 8px;
                background: pick.has-hover ? Theme.hov : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Icon {
                        width: 14px;
                        glyph: "\u{E774}";
                        size: 12px;
                        color: Theme.text2;
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        Text {
                            text: c.name;
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.strong;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: "· " + c.country;
                            font-size: 14px;
                            color: Theme.text2;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Store.city = c;
                        Store.city-search("");
                        Ui.changed();
                    }
                }
            }
        }
    }
}

export component SystemInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Weather and Location");
        first: true;
        IRow {
            label: @tr("Show when idle");
            note: @tr("Weather and city show in corner when idle");
            Toggle {
                checked <=> Store.idle-clock;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("12-hour clock");
            note: @tr("7:42 PM instead of 19:42");
            Toggle {
                checked <=> Store.clock-12h;
                toggled => { Ui.changed(); }
            }
        }
        // These two act on a place's weather: dimmed until there is one.
        IRow {
            opacity: Store.place-name != "" ? 1 : 0.4;
            label: @tr("Weather bar");
            note: @tr("Always visible beside pill and earbuds");
            Toggle {
                checked <=> Store.weather-bar;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            opacity: Store.place-name != "" ? 1 : 0.4;
            label: @tr("Weather effects");
            note: @tr("Snow, rain, sun, stars");
            Toggle {
                checked <=> Store.weather-effects;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Use my location");
            note: Store.city.name != "" ? @tr("Selected city prioritized") : Store.weather-locate ? Store.located : @tr("Off");
            Toggle {
                checked <=> Store.weather-locate;
                toggled => { Ui.changed(); }
            }
        }
        CityPicker { }
        IRow {
            label: @tr("Rain alert");
            note: Store.place-name != "" ? @tr("Brief moment before rain begins") : @tr("Select a city");
            Toggle {
                checked <=> Store.rain-moment;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Weather alerts");
            note: Store.place-name != "" ? @tr("Storm, wind, heat, freeze, air quality") : @tr("Select a city");
            Toggle {
                checked <=> Store.weather-alerts;
                toggled => { Ui.changed(); }
            }
        }
    }
}


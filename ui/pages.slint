// ================================================================== 10 Digital Wellbeing

export component WellbeingBody inherits VerticalLayout {
    alignment: start;
    H4 {
        title: @tr("Today");
        count: Store.usage-total;
    }
    if Store.usage-apps.length == 0: LRow {
        title: @tr("No screen time recorded yet");
        sub: Store.wellbeing-on ? @tr("tracked while apps are in foreground") : @tr("off");
        lead: 1;
        glyph: "\u{E95E}";
    }
    for a in Store.usage-apps: Rectangle {
        height: 54px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 7px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: a.name;
                        font-size: 14px;
                        font-weight: 500;
                        color: Theme.strong;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: a.time;
                        font-size: 13px;
                        color: Theme.text2;
                        horizontal-stretch: 0;
                    }
                }
                Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.field;
                    Rectangle {
                        x: 0px;
                        width: max(3px, parent.width * a.share);
                        border-radius: 1.5px;
                        background: #2FB37E;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Select {
                    options: [@tr("No limit"), @tr("30 min"), @tr("1 hr"), @tr("2 hrs"), @tr("3 hrs"), @tr("4 hrs")];
                    selected: a.limit;
                    box-width: 112px;
                    picked(i) => { Store.limit-set(a.exe, i); }
                }
            }
        }
    }
    Tail { }
}


// The nine pages. Each has a preview body (the middle pane: lists are real data, tiles are
// visual choices, pills are drawn at 1:1) and an inspector (the right pane: one-value settings).

import { Theme, Tags } from "theme.slint";
import { Store, Item, Team, UsageRow } from "store.slint";
import { Ui } from "ui-state.slint";
import { Icon, Toggle, MiniSlider, Seg, Keycap, Tag, IconButton, Select, Swatch, ISection, IRow, H4, LRow, Tile } from "kit.slint";
import { Pill, Pills, Art, CornerBar } from "pills.slint";

/// Formats for slider values.
global Fmt {
    public pure function pct(v: float) -> string { return @tr("%{}", round(v)); }
    public pure function offset(v: float) -> string {
        return abs(v) < 1 ? @tr("Ortada") : (v > 0 ? "+" : "−") + round(abs(v));
    }
    public pure function seconds(v: float) -> string {
        let s = round(v);
        return s < 60 ? @tr("{} sn", s) : Math.mod(s, 60) == 0 ? @tr("{} dk", s / 60) : @tr("{} dk {} sn", floor(s / 60), Math.mod(s, 60));
    }
    public pure function minutes(v: float) -> string {
        let m = round(v);
        return m == 0 ? @tr("Hemen") : m >= 60 && Math.mod(m, 60) == 0 ? @tr("{} sa", m / 60) : m >= 60 ? @tr("{} sa {} dk", floor(m / 60), Math.mod(m, 60)) : @tr("{} dk", m);
    }
}

/// A small button with a label ("Takip et", "Ekle").
component Small inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    callback clicked;
    height: 28px;
    width: row.preferred-width + 26px;
    border-radius: 8px;
    background: t.has-hover ? Theme.seg-on.brighter(20%) : Theme.seg-on;
    row := HorizontalLayout {
        x: 12px;
        width: self.preferred-width;
        spacing: 6px;
        if root.glyph != "": Icon {
            glyph: root.glyph;
            size: 11px;
            color: Theme.text;
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A row of tiles.
component Tiles inherits HorizontalLayout {
    /// A third of the row: every tile takes it, so rows of one, two or three line up without horizontal overflow.
    out property <length> tw: max(80px, (min(Ui.pane-width - 48px, 720px) - 24px) / 3);
    padding-left: 0px;
    padding-right: 0px;
    spacing: 12px;
    alignment: start;
}

/// Room at the end of a body so its last line clears the action bar.
component Tail inherits Rectangle {
    height: 76px;
}

/// Windows 11 miniature pill for the size and button tiles: 8px radius, 3×12px left #60CDFF accent bar, rounded-square art, transport controls.
component MiniPill inherits Rectangle {
    in property <length> h: 30px;
    in property <length> w: 148px;
    in property <int> buttons: 3;
    width: w;
    height: h;
    border-radius: 6px;
    background: #202020;
    border-width: 1px;
    border-color: #FFFFFF17;
    clip: true;
    // Left 3×12px system accent bar
    Rectangle {
        x: 4px;
        y: (parent.height - 12px) / 2;
        width: 2.5px;
        height: 12px;
        border-radius: 1.25px;
        background: Theme.acc;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.h * 0.62;
                height: root.h * 0.62;
                border-radius: 4px;
                background: @linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
                border-width: 1px;
                border-color: #60CDFF33;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width * 0.72;
                    height: parent.height * 0.72;
                    source: @image-url("syro-mark.png");
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                height: 3.5px;
                alignment: start;
                Rectangle {
                    width: root.w * 0.34;
                    border-radius: 1.5px;
                    background: #FFFFFFEB;
                }
            }
            HorizontalLayout {
                height: 2.5px;
                alignment: start;
                Rectangle {
                    width: root.w * 0.2;
                    border-radius: 1.25px;
                    background: #FFFFFF80;
                }
            }
        }
        if root.buttons > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 1px;
                height: root.h * 0.45;
                background: #FFFFFF17;
            }
        }
        for b[i] in root.buttons: VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.buttons == 3 && i == 1 ? root.h * 0.52 : root.h * 0.22;
                height: self.width;
                border-radius: root.buttons == 3 && i == 1 ? 4px : self.width / 2;
                background: root.buttons == 3 && i == 1 ? #FFFFFF14 : #FFFFFFBF;
            }
        }
    }
}

/// Windows 11 flyout card in miniature (#202020 surface, #191919 bottom tray, #60CDFF accent play button).
component MiniCard inherits Rectangle {
    in property <float> k: 1;
    width: 96px * k;
    height: 92px * k;
    border-radius: 8px * k;
    background: #202020;
    border-width: 1px;
    border-color: #FFFFFF17;
    clip: true;
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            padding: 7px * root.k;
            spacing: 7px * root.k;
            vertical-stretch: 1;
            Rectangle {
                width: 28px * root.k;
                height: 28px * root.k;
                border-radius: 5px * root.k;
                background: @linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
                border-width: 1px;
                border-color: #60CDFF33;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width * 0.72;
                    height: parent.height * 0.72;
                    source: @image-url("syro-mark.png");
                    image-fit: contain;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px * root.k;
                Rectangle {
                    width: 42px * root.k;
                    height: 3.5px * root.k;
                    border-radius: 1.5px;
                    background: #FFFFFFEB;
                }
                Rectangle {
                    width: 26px * root.k;
                    height: 2.5px * root.k;
                    border-radius: 1px;
                    background: #FFFFFF80;
                }
            }
        }
        Rectangle {
            height: 28px * root.k;
            background: #191919;
            HorizontalLayout {
                alignment: center;
                spacing: 8px * root.k;
                for d[i] in 3: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: i == 1 ? 14px * root.k : 6px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: i == 1 ? Theme.acc : #FFFFFF99;
                    }
                }
            }
        }
    }
}

/// Live Windows 11 Taskbar & Swift Tab Mockup showing the corner Weather+Earbuds bar on the left and the active pill in front of it.
export component Win11TaskbarMockup inherits Rectangle {
    in property <int> front-kind: 0;
    in property <bool> show-buds: true;
    in property <bool> idle-only: false;
    height: 82px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #FFFFFF14;
    background: @linear-gradient(180deg, #161B26 0%, #1C2230 58%, #181818 59%, #181818 100%);
    clip: true;

    // Top subtle desktop wallpaper caption
    Text {
        x: 14px;
        y: 8px;
        text: root.idle-only ? "Idle · When earbuds disconnected, temperature & location shown in corner" : "Windows 11 Taskbar Preview · Weather & Earbuds stay in corner, activity pill in front";
        font-size: 11.5px;
        color: #FFFFFF99;
    }

    // Bottom taskbar strip divider
    Rectangle {
        y: 30px;
        height: 1px;
        background: #FFFFFF14;
    }

    // Corner Weather & Earbuds bar + Front Pill row
    HorizontalLayout {
        x: 12px;
        y: 33px;
        height: 46px;
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            CornerBar {
                show-weather: true;
                show-buds: root.show-buds && !root.idle-only;
                idle: root.idle-only;
            }
        }
        if !root.idle-only: VerticalLayout {
            alignment: center;
            Pill {
                kind: root.front-kind;
                behind1: Store.pill-slivers ? 12 : -1;
            }
        }
    }
}

/// A window in miniature for the theme tiles.
export component MiniWindow inherits Rectangle {
    in property <color> ground;
    in property <color> side;
    in property <color> panel;
    in property <color> ink;
    width: 118px;
    height: 76px;
    border-radius: 8px;
    background: ground;
    border-width: 1px;
    border-color: #FFFFFF1A;
    HorizontalLayout {
        padding: 6px;
        spacing: 5px;
        Rectangle {
            width: 26px;
            border-radius: 5px;
            background: root.side;
        }
        Rectangle {
            border-radius: 5px;
            background: root.panel;
            VerticalLayout {
                padding: 7px;
                spacing: 5px;
                alignment: start;
                for w in [36px, 49px, 27px]: Rectangle {
                    height: 4px;
                    width: w;
                    border-radius: 2px;
                    background: root.ink;
                }
            }
        }
    }
}

// ================================================================== 0 Görünüm

export component AppearanceBody inherits VerticalLayout {
    alignment: start;
    spacing: 6px;
    H4 {
        title: @tr("Pil boyutu");
        count: @tr("3 seçenek · eski Normal artık Büyük");
    }
    Tiles {
        for o[i] in [{ t: @tr("Küçük"), s: "234 × 34 · %78", h: 24px, w: 116px }, { t: @tr("Normal"), s: "264 × 38 · %88", h: 28px, w: 136px }, { t: @tr("Büyük"), s: "300 × 44 · %100", h: 33px, w: 158px }]: Tile {
            width: parent.tw;
            title: o.t;
            sub: o.s;
            selected: Store.pill-size == i;
            clicked => {
                Store.pill-size = i;
                Ui.changed();
            }
            MiniPill {
                h: o.h;
                w: o.w;
                buttons: 1;
            }
        }
    }
    H4 {
        title: @tr("Kart boyutu");
        count: @tr("2 seçenek");
    }
    Tiles {
        Tile {
            width: parent.tw;
            title: @tr("Kompakt");
            sub: @tr("bütün kartlar %88");
            selected: Store.card-size == 0;
            clicked => {
                Store.card-size = 0;
                Ui.changed();
            }
            MiniCard { k: 0.78; }
        }
        Tile {
            width: parent.tw;
            title: @tr("Büyük");
            sub: "340 × 350";
            selected: Store.card-size == 1;
            clicked => {
                Store.card-size = 1;
                Ui.changed();
            }
            MiniCard { k: 0.92; }
        }
    }
}

export component AppearanceInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Pil");
        first: true;
        IRow {
            label: @tr("Konum");
            MiniSlider {
                value <=> Store.pill-offset;
                minimum: -200;
                maximum: 200;
                step: 2;
                centred: true;
                text: Fmt.offset(Store.pill-offset);
                moved => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Opaklık");
            MiniSlider {
                value <=> Store.pill-opacity;
                minimum: 70;
                maximum: 100;
                text: Fmt.pct(Store.pill-opacity);
                moved => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Kart ve Hareket");
        IRow {
            label: @tr("Bulanıklık (Akrilik)");
            note: Store.blur-available ? "" : @tr("Windows 11 gerekir");
            Toggle {
                checked <=> Store.card-blur;
                enabled: Store.blur-available;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Animasyon hızı");
            Select {
                options: [@tr("Kapalı"), @tr("Yavaş"), @tr("Normal"), @tr("Hızlı")];
                selected <=> Store.speed;
                box-width: 110px;
                picked => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 1 Genel

global Keys {
    public pure function of(i: int, n: int) -> string {
        // Win+Alt+N, Win+Alt+T, Ctrl+Alt+N, Win+Shift+N
        if (n == 0) { return i == 2 ? "Ctrl" : "Win"; }
        if (n == 1) { return i == 3 ? "Shift" : "Alt"; }
        return i == 1 ? "T" : "N";
    }
}

export component GeneralBody inherits VerticalLayout {
    alignment: start;
}

export component GeneralInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Başlangıç");
        first: true;
        IRow {
            label: @tr("Windows ile başlat");
            Toggle {
                checked <=> Store.autostart;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Fare");
        IRow {
            label: @tr("Ayrılınca kartı kapat");
            Toggle {
                checked <=> Store.close-on-leave;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Gecikme");
            MiniSlider {
                value <=> Store.leave-ms;
                minimum: 200;
                maximum: 3000;
                step: 100;
                enabled: Store.close-on-leave;
                text: round(Store.leave-ms) + @tr(" ms");
                moved => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Tekerlek gezer");
            note: @tr("Pilin ve kartın üstünde");
            Toggle {
                checked <=> Store.wheel-switches;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Seçtiğim önde kalsın");
            note: @tr("Yeni bir şey olana dek");
            Toggle {
                checked <=> Store.keep-user-front;
                toggled => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 2 Medya

export component MediaBody inherits VerticalLayout {
    alignment: start;
    spacing: 6px;
    H4 {
        title: @tr("Uygulamalar");
        count: Store.apps.length + @tr(" uygulama · tıkla: göster / gizle");
    }
    if Store.apps.length == 0: LRow {
        title: @tr("Henüz uygulama yok");
        sub: @tr("bir şey çalınca burada görünür");
        lead: 1;
        glyph: "\u{E8D6}";
    }
    for app[i] in Store.apps: LRow {
        title: app.name;
        sub: app.current ? @tr("şu an çalıyor") : "";
        selected: app.current;
        clickable: true;
        lead: 3;
        letter: app.letter;
        badge: app.tint;
        clicked => {
            Store.item-toggled("apps", app.id, !app.shown);
            Ui.changed();
        }
        Tag {
            text: app.shown ? @tr("Gösteriliyor") : @tr("Gizli");
            tint: app.shown ? Tags.green : Tags.red;
        }
    }
    H4 {
        title: @tr("Pil düğmeleri");
        count: @tr("3 seçenek");
    }
    Tiles {
        for o[i] in [{ t: @tr("Üç düğme"), s: @tr("önceki, oynat, sonraki"), n: 3 }, { t: @tr("Sadece oynat"), s: @tr("başlığa daha çok yer"), n: 1 }, { t: @tr("Düğmesiz"), s: @tr("yalnızca başlık"), n: 0 }]: Tile {
            width: parent.tw;
            title: o.t;
            sub: o.s;
            selected: Store.pill-buttons == i;
            clicked => {
                Store.pill-buttons = i;
                Ui.changed();
            }
            MiniPill {
                h: 28px;
                w: 132px;
                buttons: o.n;
            }
        }
    }
}

export component MediaInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Pill");
        first: true;
        IRow {
            label: @tr("Always show");
            note: @tr("Even when nothing is playing");
            Toggle {
                checked <=> Store.media-pinned;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Mute button");
            note: @tr("A speaker next to the controls that mutes the playing app");
            Toggle {
                checked <=> Store.media-pill-mute;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Marquee title");
            Select {
                options: [@tr("On change"), @tr("On hover"), @tr("Off")];
                selected <=> Store.marquee;
                box-width: 124px;
                picked => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Scroll speed");
            MiniSlider {
                value <=> Store.marquee-speed;
                minimum: 15;
                maximum: 60;
                step: 5;
                enabled: Store.marquee != 2;
                text: round(Store.marquee-speed);
                moved => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Card");
        IRow {
            label: @tr("Middle click to play");
            Toggle {
                checked <=> Store.middle-click;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Quick Spotify / YouTube button");
            note: @tr("Switch between Spotify and YouTube; off shows original app");
            Toggle {
                checked <=> Store.media-spotify-button;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Keep paused for");
            Select {
                options: [@tr("1 min"), @tr("5 min"), @tr("10 min"), @tr("30 min"), @tr("Always")];
                selected <=> Store.paused-keep;
                box-width: 84px;
                picked => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Audio outputs");
        for d in Store.devices: IRow {
            label: d.name;
            if d.current: Tag {
                text: @tr("In use");
                tint: Tags.yellow;
                small: true;
            }
            if !d.current: Toggle {
                checked: d.shown;
                toggled(v) => {
                    Store.item-toggled("devices", d.id, v);
                    Ui.changed();
                }
            }
        }
    }
}

// ================================================================== 3 Zamanlayıcı

export component TimerBody inherits VerticalLayout {
    alignment: start;
    H4 {
        title: @tr("Pilde");
        count: @tr("şu anki ayarlarla");
    }
    LRow {
        title: @tr("Zamanlayıcı");
        sub: Store.timer-on ? @tr("örnek") : @tr("kapalı");
        selected: true;
        Pill { kind: 1; }
    }
    LRow {
        title: @tr("Kronometre");
        sub: Store.stopwatch-on ? @tr("örnek") : @tr("kapalı");
        Pill { kind: 2; }
    }
    H4 {
        title: @tr("Hazır süreler");
        count: Store.presets.length + @tr(" süre · en çok altı");
    }
    // Three tiles a row, placed by hand (hidden elements would still take room in a layout).
    property <length> tw: (self.width - 20px - 24px) / 3;
    property <length> th: 110px + 52px;
    property <int> n: Store.presets.length + (Store.presets.length < 6 ? 1 : 0);
    Rectangle {
        height: Math.ceil(root.n / 3) * (root.th + 12px) - 12px;
        for m[i] in Store.presets: Tile {
            x: 10px + Math.mod(i, 3) * (root.tw + 12px);
            y: Math.floor(i / 3) * (root.th + 12px);
            width: root.tw;
            height: self.preferred-height;
            title: m + @tr(" dakika");
            sub: @tr("seçicide");
            clickable: false;
            picture-height: 110px;
            Text {
                text: m;
                font-size: 46px;
                font-weight: 700;
                color: Theme.text;
            }
            if Store.presets.length > 1: IconButton {
                x: parent.width - 34px;
                y: 4px;
                glyph: "\u{E711}";
                clicked => { Store.preset-removed(i); }
            }
        }
        if Store.presets.length < 6: Tile {
            x: 10px + Math.mod(Store.presets.length, 3) * (root.tw + 12px);
            y: Math.floor(Store.presets.length / 3) * (root.th + 12px);
            width: root.tw;
            height: self.preferred-height;
            title: @tr("Süre ekle");
            sub: @tr("dakika yaz, Enter");
            clickable: false;
            picture-height: 110px;
            Rectangle {
                width: 96px;
                height: 40px;
                border-radius: 10px;
                background: Theme.field;
                border-width: 1px;
                border-color: add.has-focus ? Theme.acc : Theme.field-edge;
                add := TextInput {
                    width: parent.width - 20px;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        let m = self.text.to-float();
                        if m >= 1 && m <= 180 {
                            Store.preset-set(-1, round(m));
                            self.text = "";
                        }
                    }
                }
            }
        }
    }
    Tail { }
}

export component TimerInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Etkinlik");
        first: true;
        IRow {
            label: @tr("Zamanlayıcı");
            Toggle {
                checked <=> Store.timer-on;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Kronometre");
            Toggle {
                checked <=> Store.stopwatch-on;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Süre dolunca");
        IRow {
            label: @tr("Alarm sesi");
            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    glyph: "\u{E768}";
                    clicked => { Store.preview-sound(Store.sound); }
                }
                Select {
                    options: Store.sounds;
                    current-text: Store.sound;
                    box-width: 112px;
                    picked(i) => {
                        Store.sound = Store.sounds[i];
                        Ui.changed();
                    }
                }
            }
        }
        IRow {
            label: @tr("Kartı aç");
            Toggle {
                checked <=> Store.done-card;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Ekle düğmesi");
            Seg {
                options: ["+1", "+5", "+10"];
                selected <=> Store.add-minutes;
                picked => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Kronometre");
        IRow {
            label: @tr("Saliseyi göster");
            Toggle {
                checked <=> Store.tenths;
                toggled => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 4 Galaxy Buds

// ================================================================== 5 Canlı maç

component TeamLead inherits Rectangle {
    in property <Team> team;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: team.has-crest ? transparent : team.primary;
    if root.team.has-crest: Image {
        width: parent.width;
        height: parent.height;
        source: root.team.crest;
        image-fit: contain;
    }
    if !root.team.has-crest: Text {
        text: root.team.abbr;
        font-size: 8.5px;
        font-weight: 800;
        color: root.team.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MatchBody inherits VerticalLayout {
    alignment: start;
    if Ui.query != "": VerticalLayout {
        H4 {
            title: @tr("Sonuçlar");
            count: Store.team-search-state == 1 ? @tr("aranıyor…") : Store.team-search-state == 3 ? @tr("ESPN'e ulaşılamadı") : Store.team-results.length + @tr(" takım · ESPN");
        }
        if Store.team-search-state == 2 && Store.team-results.length == 0: LRow {
            title: @tr("Takım bulunamadı");
            sub: @tr("başka bir ad dene");
            lead: 1;
            glyph: "\u{E721}";
        }
        for t[i] in Store.team-results: LRow {
            title: t.name;
            sub: t.league;
            selected: i == 0;
            clickable: !t.followed;
            lead: 4;
            clicked => { Store.team-added(t); }
            TeamLead { team: t; }
            if t.followed: Tag {
                text: @tr("Takipte");
                tint: Tags.green;
            }
            if !t.followed && i == 0: Keycap { key: "↵"; }
        }
    }
    if Ui.query == "": VerticalLayout {
        H4 {
            title: @tr("Maç pili");
            count: @tr("şu anki ayarlarla");
        }
        LRow {
            title: Store.teams.length >= 2 ? Store.teams[0].name + " – " + Store.teams[1].name : @tr("Örnek maç");
            sub: Store.match-on ? @tr("canlı, örnek") : @tr("kapalı");
            selected: true;
            lead: Store.teams[0].has-crest ? 2 : 4;
            image: Store.teams[0].crest;
            Tag {
                text: @tr("Canlı");
                tint: Tags.red;
            }
            Pill {
                kind: 4;
                // Out of range reads the default (no crest): the stand-ins then show.
                home-has: Store.teams[0].has-crest;
                home-crest: Store.teams[0].crest;
                home-code: Store.teams.length >= 1 ? Store.teams[0].abbr : "FB";
                home-tint: Store.teams.length >= 1 ? Store.teams[0].primary : #0B2A6F;
                home-ink: Store.teams.length >= 1 ? Store.teams[0].secondary : #FFE500;
                away-has: Store.teams[1].has-crest;
                away-crest: Store.teams[1].crest;
                away-code: Store.teams.length >= 2 ? Store.teams[1].abbr : "GS";
                away-tint: Store.teams.length >= 2 ? Store.teams[1].primary : #A90432;
                away-ink: Store.teams.length >= 2 ? Store.teams[1].secondary : #FDB912;
            }
        }
        H4 {
            title: @tr("Takip ettiklerin");
            count: Store.teams.length + @tr(" takım");
        }
        Rectangle {
            property <length> tw: (self.width - 20px - 24px) / 3;
            property <length> th: 140px + 52px;
            height: Math.ceil((Store.teams.length + 1) / 3) * (self.th + 12px) - 12px;
            for t[i] in Store.teams: Tile {
                x: 10px + Math.mod(i, 3) * (parent.tw + 12px);
                y: Math.floor(i / 3) * (parent.th + 12px);
                width: parent.tw;
                height: self.preferred-height;
                title: t.name;
                sub: t.league;
                clickable: false;
                fill: @radial-gradient(circle, t.primary.with-alpha(0.55) 0%, Theme.tile 70%);
                if t.has-crest: Image {
                    width: 64px;
                    height: 64px;
                    source: t.crest;
                    image-fit: contain;
                }
                if !t.has-crest: Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: t.primary;
                    Text {
                        text: t.abbr;
                        font-size: 20px;
                        font-weight: 800;
                        color: t.secondary;
                    }
                }
                IconButton {
                    x: parent.width - 34px;
                    y: 4px;
                    glyph: "\u{E711}";
                    clicked => { Store.team-removed(i); }
                }
            }
            Tile {
                x: 10px + Math.mod(Store.teams.length, 3) * (parent.tw + 12px);
                y: Math.floor(Store.teams.length / 3) * (parent.th + 12px);
                width: parent.tw;
                height: self.preferred-height;
                title: @tr("Takım ekle");
                sub: @tr("yukarıda ara");
                clicked => { Ui.focus-search(); }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    border-width: 1.5px;
                    border-color: Theme.text3;
                    Icon {
                        glyph: "\u{E710}";
                        size: 14px;
                        color: Theme.text2;
                    }
                }
            }
        }
    }
    Tail { }
}

export component MatchInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Activity");
        first: true;
        IRow {
            label: @tr("Live match");
            Toggle {
                checked <=> Store.match-on;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("When");
        IRow {
            label: @tr("Before match");
            MiniSlider {
                value <=> Store.show-before;
                minimum: 0;
                maximum: 180;
                step: 15;
                text: Store.show-before == 0 ? @tr("When started") : Fmt.minutes(Store.show-before);
                moved => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Keep after");
            MiniSlider {
                value <=> Store.keep-after;
                minimum: 0;
                maximum: 120;
                step: 5;
                text: Fmt.minutes(Store.keep-after);
                moved => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Moments");
        IRow {
            label: @tr("Opponent goal moment");
            note: @tr("Pill expands briefly when goal scored");
            Toggle {
                checked <=> Store.opponent-moment;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Goal sound");
            note: @tr("When your team scores");
            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    glyph: "\u{E768}";
                    clicked => { Store.preview-sound(Store.goal-sound); }
                }
                Select {
                    options: Store.goal-sounds;
                    current-text: Store.goal-sound;
                    box-width: 112px;
                    picked(i) => {
                        Store.goal-sound = Store.goal-sounds[i];
                        Ui.changed();
                    }
                }
            }
        }
    }
}

// ================================================================== 6 Fullscreen

export component FullscreenBody inherits VerticalLayout {
    alignment: start;
    H4 {
        title: @tr("Exceptions");
        count: Store.exceptions.length + @tr(" apps · visible in fullscreen");
    }
    if Store.exceptions.length == 0: LRow {
        title: @tr("No exceptions yet");
        sub: @tr("enter an application name above");
        lead: 1;
        glyph: "\u{E737}";
    }
    for e[i] in Store.exceptions: LRow {
        title: e;
        sub: "";
        selected: i == 0;
        lead: 1;
        glyph: "\u{E737}";
        Tag {
            text: @tr("Visible");
            tint: Tags.green;
        }
        IconButton {
            glyph: "\u{E711}";
            clicked => { Store.exception-removed(i); }
        }
    }
    H4 {
        title: @tr("Running Applications");
        count: @tr("click to add exception");
    }
    for a in Store.running-apps: LRow {
        title: a.id;
        sub: a.name;
        clickable: true;
        lead: 1;
        glyph: "\u{E737}";
        clicked => { Ui.error = Store.exception-added(a.id); }
        Small {
            text: @tr("Add");
            glyph: "\u{E710}";
            clicked => { Ui.error = Store.exception-added(a.id); }
        }
    }
    Tail { }
}

/// "Hide in fullscreen" is the page header's switch (settings.slint).
export component FullscreenInspector inherits VerticalLayout {
    alignment: start;
}


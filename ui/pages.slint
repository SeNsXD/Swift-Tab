        }
    }
    ISection {
        title: @tr("Music");
        IRow {
            label: @tr("Music of the week");
            note: @tr("Tracks played counted locally");
            Toggle {
                checked <=> Store.music-week;
                toggled => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 11 Clipboard

/// The on/off switch is the page header's; the types are in the inspector's "What to keep".
export component ClipboardBody inherits VerticalLayout {
    alignment: start;
}

export component ClipboardInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Behavior");
        first: true;
        IRow {
            label: @tr("Always show");
            note: @tr("Even when nothing is copied");
            Toggle {
                checked <=> Store.clipboard-pinned;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Show in pill on copy");
            note: @tr("Pill pops up briefly when you copy");
            Toggle {
                checked <=> Store.clipboard-popup;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("What to keep");
        IRow {
            label: @tr("Text");
            note: @tr("Copied text clips");
            Toggle {
                checked <=> Store.clipboard-text;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Links");
            note: @tr("Web links and addresses");
            Toggle {
                checked <=> Store.clipboard-links;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Images");
            note: @tr("Pictures and screenshots");
            Toggle {
                checked <=> Store.clipboard-images;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Rich Formatting");
            note: @tr("Only plain text retained when off");
            Toggle {
                checked <=> Store.clipboard-rich;
                toggled => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 12 Shelf

export component ShelfBody inherits VerticalLayout {
    alignment: start;
    spacing: 6px;
    H4 {
        title: @tr("How to Use");
        count: @tr("3 tips");
    }
    LRow {
        title: @tr("Drop files");
        sub: @tr("drag to pill: stored on shelf");
        lead: 1;
        glyph: "\u{E896}";
    }
    LRow {
        title: @tr("Scroll to open");
        sub: @tr("scroll wheel switches between pill cards");
        lead: 1;
        glyph: "\u{E72A}";
    }
    LRow {
        title: @tr("Drag out");
        sub: @tr("pick files from shelf and drop anywhere");
        lead: 1;
        glyph: "\u{E8A7}";
    }
}

/// "Enable Shelf" is the page header's switch (settings.slint).
export component ShelfInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Pill");
        first: true;
        IRow {
            label: @tr("Always show");
            note: @tr("Even when the shelf is empty");
            Toggle {
                checked <=> Store.shelf-pinned;
                toggled => { Ui.changed(); }
            }
        }
    }
}

// ================================================================== 15 Sticky Notes

export component NotesBody inherits VerticalLayout {
    alignment: start;
    spacing: 6px;
    H4 {
        title: @tr("How to Use");
        count: @tr("4 tips");
    }
    LRow {
        title: @tr("Middle-click to write");
        sub: @tr("middle-click the pill to immediately open a new note");
        lead: 1;
        glyph: "\u{E70B}";
    }
    LRow {
        title: @tr("Scroll between activities");
        sub: @tr("scroll wheel on the pill cycles between Notes, Shelf and Clipboard");
        lead: 1;
        glyph: "\u{E72A}";
    }
    LRow {
        title: @tr("Paste images");
        sub: @tr("press Ctrl+V inside the note to attach screenshots or images");
        lead: 1;
        glyph: "\u{EB9F}";
    }
    LRow {
        title: @tr("Continuous auto-save");
        sub: @tr("everything you write is automatically saved to notes.json");
        lead: 1;
        glyph: "\u{E74E}";
    }
}

export component NotesInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Floating Behavior");
        first: true;
        IRow {
            label: @tr("Translucent when inactive");
            note: @tr("Stays open at 50% opacity. Turn off to auto-close when mouse leaves.");
            Toggle {
                checked <=> Store.notes-translucent-on-leave;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            label: @tr("Always show in pill");
            note: @tr("Include Sticky Notes in the pill and wheel cycle even when empty");
            Toggle {
                checked <=> Store.notes-pinned;
                toggled => { Ui.changed(); }
            }
        }
    }
}


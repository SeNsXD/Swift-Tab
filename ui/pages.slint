export component AboutBody inherits VerticalLayout {
    alignment: start;
    spacing: 10px;
    padding-top: 10px;
    padding-bottom: 0px;

    // Hero App Card
    Rectangle {
        height: 84px;
        border-radius: 10px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-edge;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 8px;
                    background: Theme.sel-row;
                    border-width: 1px;
                    border-color: Theme.acc.with-alpha(0.3);
                    Image {
                        source: @image-url("syro-mark.png");
                        width: 28px;
                        height: 28px;
                        image-fit: contain;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: "Swift Tab";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.strong;
                }
                Text {
                    text: "Compact Windows 11 Taskbar Companion";
                    font-size: 13px;
                    color: Theme.text2;
                }
            }
            VerticalLayout {
                alignment: center;
                Tag {
                    text: "v1.0 Release";
                    tint: Tags.green;
                }
            }
        }
    }

    H4 {
        title: "Product Information";
        count: "specifications & architecture";
    }

    LRow {
        title: "Version & Platform";
        sub: "v1.0 · Windows 11 x64 (x86_64-pc-windows-msvc)";
        lead: 1;
        glyph: "\u{E946}";
    }

    LRow {
        title: "Graphics Engine";
        sub: "Direct2D, DirectWrite & Windows.UI.Composition APIs";
        lead: 1;
        glyph: "\u{E790}";
    }

    LRow {
        title: "Settings Interface";
        sub: "Slint UI Framework with Segoe UI Variable typography";
        lead: 1;
        glyph: "\u{E713}";
    }

    H4 {
        title: "Open Source & Credits";
        count: "repository & acknowledgments";
    }

    LRow {
        title: "GitHub Repository";
        sub: "github.com/SeNsXD/Swift-Tab";
        clickable: true;
        lead: 1;
        glyph: "\u{E8A7}";
        clicked => { Store.action("repo"); }
    }

    LRow {
        title: "App Concept & Inspiration";
        sub: "Original app idea and companion concept credited to Now Bar";
        lead: 1;
        glyph: "\u{E790}";
    }

    LRow {
        title: "Software License";
        sub: "GNU General Public License v3.0";
        lead: 1;
        glyph: "\u{E8A5}";
    }
}


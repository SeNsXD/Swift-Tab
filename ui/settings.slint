// Swift Tab settings in the XDNOT Labs look. Layout from Raycast's Theme Studio (design: .taste-skill/v9): an inset
// list panel on the left, a preview panel in the middle (search bar, the page's lists and
// tiles, the action bar), an inspector on the right. Every value lives in `Store`; the Rust
// side fills it from settings.json and saves it on `changed()`.

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

import { Theme, Tags } from "theme.slint";
import { Store, Hit } from "store.slint";
import { Ui } from "ui-state.slint";
import { Icon, Toggle, Keycap, Tag, IconButton, H4, LRow, SideItem } from "kit.slint";
import {
    AppearanceBody, AppearanceInspector, GeneralBody, GeneralInspector, MediaBody, MediaInspector, TimerBody, TimerInspector,
    MatchBody, MatchInspector, FullscreenBody, FullscreenInspector, AboutBody, AboutInspector,
    SystemBody, SystemInspector, EventsInspector, GamesBody, GamesInspector, WellbeingBody, WellbeingInspector, ClipboardBody, ClipboardInspector, ShelfBody, ShelfInspector,
    Win11TaskbarMockup
} from "pages.slint";

/// A Home card: what it is, its state on the right, the value and a line under it.
component HomeCard inherits Rectangle {
    in property <string> label;
    in property <string> tag;
    in property <color> tag-color: Theme.acc;
    in property <string> value;
    in property <string> sub;
    horizontal-stretch: 1;
    min-height: 86px;
    border-radius: 8px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.field-edge;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: root.label;
                font-size: 12px;
                color: Theme.text2;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.tag;
                font-size: 12px;
                font-weight: 600;
                color: root.tag-color;
                horizontal-alignment: right;
            }
        }
        Text {
            text: root.value;
            font-size: 15px;
            font-weight: 600;
            color: Theme.strong;
            overflow: elide;
        }
        Text {
            text: root.sub;
            font-size: 11.5px;
            color: Theme.text3;
            wrap: word-wrap;
        }
    }
}

/// The Swift Tab ribbon mark.
component Mark inherits Rectangle {
    width: 28px;
    height: 28px;
    Image {
        source: @image-url("syro-mark.png");
        width: 28px;
        height: 28px;
        image-fit: contain;
    }
}

/// The Antigravity backdrop: a plain near-black ground with a faint deep-blue glow rising from
/// the top edge (the old pixel-cube decoration is gone).
component PixelField inherits Rectangle {
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: min(parent.height, 360px);
        background: @linear-gradient(180deg, Theme.glow 0%, #00000000 100%);
    }
}

/// The one switch of a page, at its top: what the page is, and whether it is on. The rest of
/// the page dims and stops answering while it is off (the page wraps it in a `Rectangle`).
component PageHero inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> glyph;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 68px;
    border-radius: 14px;
    background: Theme.card;
    border-width: 1px;
    border-color: root.checked ? Theme.acc.with-alpha(0.4) : Theme.card-edge;
    animate border-color { duration: 150ms; }
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 11px;
                background: Theme.sel-row;
                Icon {
                    width: parent.width;
                    height: parent.height;
                    glyph: root.glyph;
                    size: 18px;
                    color: Theme.acc;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.strong;
                overflow: elide;
            }
            Text {
                text: root.sub;
                font-size: 12px;
                color: Theme.text3;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

/// "Ayarlar  2" in the list panel.
component SideLabel inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    padding-left: 10px;
    padding-top: 10px;
    padding-bottom: 6px;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        color: Theme.dark ? #B0B0B0 : #6E6E73;
    }
    Text {
        text: root.count;
        font-size: 13px;
        color: Theme.text3;
    }
}

/// One entry of the actions menu.
component ActionItem inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> danger;
    callback clicked;
    height: 34px;
    border-radius: 4px;
    background: t.has-hover ? Theme.sel-row : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            glyph: root.glyph;
            size: 13px;
            width: 16px;
            color: root.danger ? Theme.danger : Theme.text2;
        }
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 500;
            color: root.danger ? Theme.danger : Theme.text;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One link row inside the Help & Support card.
component HelpLinkRow inherits Rectangle {
    in property <image> icon-source;
    in property <string> name;
    in property <string> detail;
    in property <string> url;

    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hov : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        Image {
            source: root.icon-source;
            width: 15px;
            height: 15px;
            image-fit: contain;
        }

        Text {
            text: root.name;
            font-size: 11.5px;
            font-weight: 500;
            color: Theme.strong;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.detail;
            font-size: 10px;
            color: Theme.text3;
            vertical-alignment: center;
        }

        Text {
            text: "\u{E8A7}";
            font-family: Theme.icons;
            font-size: 10px;
            color: touch.has-hover ? Theme.strong : Theme.text3;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Store.action(root.url);
        }
    }
}

/// Help and Support card for community and support links in the sidebar below System Events.
component HelpSupportCard inherits Rectangle {
    border-radius: 8px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.field-edge;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            padding-left: 2px;
            cross-axis-alignment: center;
            Text {
                text: "Help and Support";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.strong;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 3px;

            HelpLinkRow {
                icon-source: @image-url("icon-github.svg");
                name: "GitHub";
                detail: "SeNsXD";
                url: "https://github.com/SeNsXD";
            }
            HelpLinkRow {
                icon-source: @image-url("icon-discord.svg");
                name: "Discord";
                detail: "Community";
                url: "https://discord.gg/X9b6TSYdVk";
            }
            HelpLinkRow {
                icon-source: @image-url("icon-x.svg");
                name: "X";
                detail: "@rixh4bh";
                url: "https://x.com/rixh4bh";
            }
            HelpLinkRow {
                icon-source: @image-url("icon-youtube.svg");
                name: "YouTube";
                detail: "@xdNOTLabs";
                url: "https://www.youtube.com/@xdNOTLabs";
            }
        }
    }
}

/// An empty part of the chrome: dragging it moves the window (Windows does the dragging, so
/// snapping works); a double click maximises or restores. A plain click does nothing: starting
/// the system's drag on the press left the window without the button-up, and the clicks after it
/// went nowhere.
component DragArea inherits TouchArea {
    property <bool> started;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            self.started = false;
        }
    }
    moved => {
        if self.pressed && !self.started {
            self.started = true;
            Ui.drag-window();
        }
    }
    double-clicked => { Ui.toggle-maximize(); }
}

/// A caption button at the top right: kind 0 = minimise, 1 = maximise/restore, 2 = close (red under the mouse).
component CaptionButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> maximized: false;
    in property <bool> close: false;
    callback clicked;
    width: 40px;
    height: 32px;
    border-radius: 6px;
    background: t.pressed ? (close ? #C42B1CCC : Theme.sel) : t.has-hover ? (close ? #C42B1C : Theme.hov) : transparent;
    animate background { duration: 83ms; }
    property <color> ink: t.has-hover && root.close ? #FFFFFF : Theme.strong;

    // 0: Minimize line
    if root.kind == 0: Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 1.2px) / 2;
        width: 10px;
        height: 1.2px;
        background: root.ink;
    }

    // 1: Maximize single square (when not maximized)
    if root.kind == 1 && !root.maximized: Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-radius: 1.5px;
        border-width: 1.2px;
        border-color: root.ink;
        background: transparent;
    }

    // 1: Restore double-square (when maximized)
    if root.kind == 1 && root.maximized: Rectangle {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        // Back window square (top-right)
        Rectangle {
            x: 2px;
            y: 0px;
            width: 8px;
            height: 8px;
            border-radius: 1.2px;
            border-width: 1.2px;
            border-color: root.ink;
            background: transparent;
        }
        // Front window square (bottom-left)
        Rectangle {
            x: 0px;
            y: 2px;
            width: 8px;
            height: 8px;
            border-radius: 1.2px;
            border-width: 1.2px;
            border-color: root.ink;
            background: t.pressed ? (root.close ? #C42B1CCC : Theme.sel) : t.has-hover ? (root.close ? #C42B1C : Theme.hov) : Theme.ground;
        }
    }

    // 2: Close X crisp vector path
    if root.kind == 2: Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
         viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.ink;
        stroke-width: 1.3px;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
    }

    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Invisible handles along the edges and corners: pressing one sizes the window from it.
component ResizeEdges inherits Rectangle {
    property <length> e: 4px;
    property <length> c: 10px;
    for h in [
        { code: 12, x: c, y: 0px, w: max(0px, root.width - c - 144px), ht: e, cursor: MouseCursor.ns-resize },
        { code: 15, x: c, y: root.height - e, w: root.width - 2 * c, ht: e, cursor: MouseCursor.ns-resize },
        { code: 10, x: 0px, y: c, w: e, ht: root.height - 2 * c, cursor: MouseCursor.ew-resize },
        { code: 11, x: root.width - e, y: 54px, w: e, ht: max(0px, root.height - 54px - c), cursor: MouseCursor.ew-resize },
        { code: 13, x: 0px, y: 0px, w: c, ht: c, cursor: MouseCursor.nwse-resize },
        { code: 17, x: root.width - c, y: root.height - c, w: c, ht: c, cursor: MouseCursor.nwse-resize },
        { code: 16, x: 0px, y: root.height - c, w: c, ht: c, cursor: MouseCursor.nesw-resize },
    ]: TouchArea {
        x: h.x;
        y: h.y;
        width: h.w;
        height: h.ht;
        mouse-cursor: h.cursor;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                Ui.resize-window(h.code);
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Swift Tab Settings";
    // Its own title bar: the caption buttons sit in the inspector's header (Raycast's layout).
    no-frame: !Ui.framed;
    // The no-background Swift Tab ribbon logo.
    icon: @image-url("syro-mark.png");
    preferred-width: 1240px;
    preferred-height: 760px;
    min-width: 1040px;
    min-height: 640px;
    default-font-family: Theme.text-face;
    default-font-size: 14px;
    background: Theme.ground;
    changed width => { Ui.sized(); }
    changed height => { Ui.sized(); }

    /// Settings pages search the settings; Canlı maç and Tam ekran use the bar for their lists.
    property <bool> settings-search: Store.page != 5 && Store.page != 6;
    property <bool> searching: settings-search && Ui.query != "";
    property <[Hit]> hits: searching ? Store.search(Ui.query) : [];
    property <string> primary: searching ? (hits.length > 0 ? "Open" : "")
        : Store.page == 5 && Ui.query != "" && Store.team-results.length > 0 && !Store.team-results[0].followed ? "Follow"
        : Store.page == 6 && Ui.query != "" ? "Add" : "";
    property <string> placeholder: Store.page == 5 ? "Search team…" : Store.page == 6 ? "Add application, e.g. vlc.exe" : "Search settings…";
    property <int> focus-serial: Ui.focus-serial;
    changed focus-serial => { search.focus(); }

    function go(p: int) {
        Store.page = p;
        root.clear();
    }
    function clear() {
        Ui.query = "";
        Ui.error = "";
        search.text = "";
        Store.team-search("");
    }
    /// Enter in the search bar, or the action bar's primary action.
    function submit() {
        if root.searching {
            if root.hits.length > 0 {
                root.go(root.hits[0].page);
            }
        } else if Store.page == 5 {
            if Store.team-results.length > 0 && !Store.team-results[0].followed {
                Store.team-added(Store.team-results[0]);
            }
        } else if Store.page == 6 && Ui.query != "" {
            Ui.error = Store.exception-added(Ui.query);
            if Ui.error == "" {
                Ui.query = "";
                search.text = "";
            }
        }
    }

    // The ground's light, below the preview panel.
    Rectangle {
        width: root.width * 1.3;
        height: self.width;
        x: root.width * 0.52 - self.width / 2;
        y: root.height - self.height / 2 + 60px;
        background: @radial-gradient(circle, Theme.ground-lit 0%, Theme.ground 50%);
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "f" || e.text == "F") {
                search.focus();
                return accept;
            }
            if e.modifiers.control && (e.text == "k" || e.text == "K") {
                Ui.actions = true;
                actions.show();
                return accept;
            }
            if e.text == Key.Escape {
                if Ui.dialog {
                    Ui.dialog = false;
                } else {
                    root.clear();
                }
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // ------------------------------------------------ 1. Fluent Navigation Rail (260px)
            Rectangle {
                width: 260px;
                background: Theme.side-bot;

                // 1px right border divider
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.pv-edge;
                }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 6px;

                    // Brand Card
                    Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.field-edge;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Mark { }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: "Swift Tab";
                                    font-size: 14.5px;
                                    font-weight: 600;
                                    color: Theme.strong;
                                }
                                Text {
                                    text: "v1.0";
                                    font-size: 11px;
                                    color: Theme.text3;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> Store.enabled;
                                    toggled => { Ui.changed(); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }

                    // The tabs scroll when the window is too short for all of them (the window can be as
                    // small as 640 px, or smaller on a scaled screen): the brand card above and
                    // "About" below stay in place.
                    Flickable {
                        vertical-stretch: 1;
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            SideLabel {
                                title: "GENERAL";
                                count: "4";
                            }
                            SideItem {
                                title: "Home";
                                glyph: "\u{E80F}";
                                current: Store.page == 13;
                                clicked => { root.go(13); }
                            }
                            SideItem {
                                title: "Appearance";
                                glyph: "\u{E790}";
                                current: Store.page == 0;
                                clicked => { root.go(0); }
                            }
                            SideItem {
                                title: "Behavior";
                                glyph: "\u{E713}";
                                current: Store.page == 1;
                                clicked => { root.go(1); }
                            }
                            SideItem {
                                title: "Full Screen";
                                glyph: "\u{E740}";
                                current: Store.page == 6;
                                off: !Store.fullscreen-hide;
                                clicked => { root.go(6); }
                            }

                            Rectangle { height: 4px; }
                            SideLabel {
                                title: "ACTIVITIES";
                                count: "7";
                            }
                            SideItem {
                                title: "Media";
                                glyph: "\u{E8D6}";
                                current: Store.page == 2;
                                live: Store.media-live;
                                off: !Store.media-on;
                                clicked => { root.go(2); }
                            }
                            SideItem {
                                title: "Weather";
                                glyph: "\u{E753}";
                                current: Store.page == 8;
                                off: !Store.weather-bar && !Store.idle-clock;
                                clicked => { root.go(8); }
                            }
                            SideItem {
                                title: "Headphones";
                                glyph: "\u{E7F6}";
                                current: Store.page == 4;
                                off: !Store.headsets-on;
                                clicked => { root.go(4); }
                            }
                            SideItem {
                                title: "Clipboard";
                                glyph: "\u{E77F}";
                                current: Store.page == 11;
                                off: !Store.clipboard-stash;
                                clicked => { root.go(11); }
                            }
                            SideItem {
                                title: "Shelf";
                                glyph: "\u{E8F1}";
                                current: Store.page == 12;
                                off: !Store.shelf-on;
                                clicked => { root.go(12); }
                            }
                            SideItem {
                                title: "Games";
                                glyph: "\u{E7FC}";
                                current: Store.page == 9;
                                off: !Store.games-downloads && !Store.games-playtime;
                                clicked => { root.go(9); }
                            }
                            SideItem {
                                title: "System Events";
                                glyph: "\u{E7ED}";
                                current: Store.page == 14;
                                off: !Store.capture-moment && !Store.capture-to-shelf && !Store.transfer-on;
                                clicked => { root.go(14); }
                            }

                            Rectangle { height: 6px; }

                            HelpSupportCard { }
                        }
                    }

                    SideLabel {
                        title: "INFO";
                        count: "1";
                    }
                    SideItem {
                        title: "About Swift Tab";
                        glyph: "\u{E946}";
                        current: Store.page == 7;
                        clicked => { root.go(7); }
                    }

                }
            }

            // ------------------------------------------------ 2. Main Content Canvas (Unified, No Inspector)
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.ground;
                clip: true;
                PixelField {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                }
                VerticalLayout {
                    // Top Fluent Title / Header Bar
                    Rectangle {
                        height: 54px;
                        DragArea { }
                        // 1px bottom border divider
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.pv-edge;
                        }
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 12px;
                            spacing: 16px;
                            cross-axis-alignment: center;

                            // Title & Breadcrumb
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text {
                                    text: Store.page == 13 ? "Home"
                                        : Store.page == 0 ? "Appearance"
                                        : Store.page == 1 ? "Behavior"
                                        : Store.page == 2 ? "Media"
                                        : Store.page == 4 ? "Headphones"
                                        : Store.page == 6 ? "Full Screen"
                                        : Store.page == 7 ? "About"
                                        : Store.page == 8 ? "Weather"
                                        : Store.page == 14 ? "System Events"
                                        : Store.page == 9 ? "Games"
                                        : Store.page == 11 ? "Clipboard"
                                        : Store.page == 12 ? "Shelf"
                                        : "Swift Tab Control Center";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Theme.strong;
                                    vertical-alignment: center;
                                }
                                // Only a problem shows here (a bad exception name, a failed save).
                                if Ui.error != "": Text {
                                    text: Ui.error;
                                    font-size: 12px;
                                    color: Theme.danger;
                                    vertical-alignment: center;
                                }
                            }

                            // Inline Fluent Search
                            Rectangle {
                                width: 220px;
                                height: 32px;
                                border-radius: 6px;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: search.has-focus ? Theme.acc : Theme.field-edge;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Icon {
                                        glyph: "\u{E721}";
                                        size: 12px;
                                        color: Theme.text2;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Text {
                                            x: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            visible: search.text == "";
                                            text: root.placeholder;
                                            font-size: 12.5px;
                                            color: Theme.placeholder;
                                            vertical-alignment: center;
                                        }
                                        search := TextInput {
                                            x: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            font-size: 12.5px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => {
                                                Ui.query = self.text;
                                                Ui.error = "";
                                            }
                                            accepted => { root.submit(); }
                                        }
                                    }
                                }
                            }

                            // Window Caption Buttons
                            HorizontalLayout {
                                spacing: 4px;
                                CaptionButton {
                                    kind: 0;
                                    clicked => { Ui.minimize-window(); }
                                }
                                CaptionButton {
                                    kind: 1;
                                    maximized: Ui.maximized;
                                    clicked => { Ui.toggle-maximize(); }
                                }
                                CaptionButton {
                                    kind: 2;
                                    close: true;
                                    clicked => { Ui.close-window(); }
                                }
                            }
                        }
                    }

                    // Unified Page Content (Flickable)
                    Flickable {
                        vertical-stretch: 1;
                        content-width: self.width;
                        init => { Ui.pane-width = self.width; }
                        changed width => { Ui.pane-width = self.width; }
                        VerticalLayout {
                            // A readable column (720px at most), centred in wide windows.
                            padding-left: max(24px, (Ui.pane-width - 720px) / 2);
                            padding-right: max(24px, (Ui.pane-width - 720px) / 2);
                            padding-top: 18px;
                            padding-bottom: 32px;
                            spacing: 16px;
                            alignment: start;

                            // 1. Search Results
                            if root.searching: VerticalLayout {
                                spacing: 8px;
                                H4 {
                                    title: "Search Results";
                                    count: root.hits.length + " settings";
                                }
                                if root.hits.length == 0: LRow {
                                    title: "No results found";
                                    sub: "Try searching with different keywords";
                                    lead: 1;
                                    glyph: "\u{E721}";
                                }
                                for h[i] in root.hits: LRow {
                                    title: h.title;
                                    sub: h.path;
                                    selected: i == 0;
                                    clickable: true;
                                    lead: 1;
                                    glyph: "\u{E721}";
                                    clicked => { root.go(h.page); }
                                    if i == 0: Keycap { key: "↵"; }
                                }
                            }

                            // 2. Home: how Syro is doing, live
                            if !root.searching && Store.page == 13: VerticalLayout {
                                spacing: 12px;
                                Rectangle {
                                    border-radius: 8px;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: Theme.field-edge;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 6px;
                                            background: Theme.sel-row;
                                            HorizontalLayout {
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("syro-mark.png");
                                                        width: 24px;
                                                        height: 24px;
                                                        image-fit: contain;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: Store.enabled ? "Swift Tab is active and running" : "Swift Tab is turned off";
                                                font-size: 15px;
                                                font-weight: 600;
                                                color: Theme.strong;
                                            }
                                            Text {
                                                text: Store.card-blur ? "Docked to the Windows 11 taskbar · Acrylic backdrop active" : "Docked to the Windows 11 taskbar";
                                                font-size: 12px;
                                                color: Theme.text2;
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 8px;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: Theme.field-edge;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        Text {
                                            text: "Activity Modules";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.strong;
                                        }
                                        // 1. Media
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Media";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Show currently playing track in the pill and media card";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.media-on;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.pv-edge;
                                        }
                                        // 2. Earbuds
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Earbuds";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Show connected Bluetooth earbuds and headphone battery in the corner";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked: Store.buds-on || Store.headsets-on;
                                                    toggled => {
                                                        Store.buds-on = self.checked;
                                                        Store.headsets-on = self.checked;
                                                        Ui.changed();
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.pv-edge;
                                        }
                                        // 3. Weather
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Weather";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Show live temperature and sky conditions in the corner bar";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.weather-bar;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.pv-edge;
                                        }
                                        // 4. Clipboard
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Clipboard";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Keep copied text, links, and images in the clipboard stash";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.clipboard-stash;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.pv-edge;
                                        }
                                        // 5. Shelf
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Shelf";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Drop files onto the pill to hold and drag them out anywhere";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.shelf-on;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 8px;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: Theme.field-edge;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        Text {
                                            text: "Idle Pill Animation";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.strong;
                                        }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Glass Cleaner Guy";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Show animated cleaner with water spray behind the empty pill";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.cleaner-anim;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 8px;
                                    background: Theme.field;
                                    border-width: 1px;
                                    border-color: Theme.field-edge;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        Text {
                                            text: "Media Quick Launcher";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.strong;
                                        }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Quick Spotify / YouTube button";
                                                    font-size: 13px;
                                                    color: Theme.text;
                                                }
                                                Text {
                                                    text: "Quick launcher in media card (switches to Spotify or YouTube; off shows original app)";
                                                    font-size: 11.5px;
                                                    color: Theme.text3;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Toggle {
                                                    checked <=> Store.media-spotify-button;
                                                    toggled => { Ui.changed(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 3. Other Pages (Appearance, Behavior, Media, System, Headphones, Clipboard, Shelf, Fullscreen, About)
                            if !root.searching && Store.page == 0: VerticalLayout {
                                spacing: 14px;
                                AppearanceBody { }
                                AppearanceInspector { }
                            }
                            if !root.searching && Store.page == 1: VerticalLayout {
                                spacing: 14px;
                                GeneralInspector { }
                            }
                            if !root.searching && Store.page == 2: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Media";
                                    sub: "Show the playing track in the pill and the card";
                                    glyph: "\u{E8D6}";
                                    checked <=> Store.media-on;
                                    toggled => { Ui.changed(); }
                                }
                                Rectangle {
                                    opacity: Store.media-on ? 1 : 0.38;
                                    VerticalLayout {
                                        spacing: 14px;
                                        MediaBody { }
                                        MediaInspector { }
                                    }
                                    if !Store.media-on: TouchArea { }
                                }
                            }
                            if !root.searching && Store.page == 3: VerticalLayout {
                                spacing: 14px;
                                TimerBody { }
                                TimerInspector { }
                            }
                            if !root.searching && Store.page == 4: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Headphones";
                                    sub: "Show connected earbuds and their battery in the corner";
                                    glyph: "\u{E7F6}";
                                    checked <=> Store.headsets-on;
                                    toggled => { Ui.changed(); }
                                }
                            }
                            if !root.searching && Store.page == 5: VerticalLayout {
                                spacing: 14px;
                                MatchBody { }
                                MatchInspector { }
                            }
                            if !root.searching && Store.page == 6: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Hide in full screen";
                                    sub: "While games, videos or presentations are in full screen";
                                    glyph: "\u{E740}";
                                    checked <=> Store.fullscreen-hide;
                                    toggled => { Ui.changed(); }
                                }
                                Rectangle {
                                    opacity: Store.fullscreen-hide ? 1 : 0.38;
                                    VerticalLayout {
                                        spacing: 14px;
                                        FullscreenBody { }
                                    }
                                    if !Store.fullscreen-hide: TouchArea { }
                                }
                            }
                            if !root.searching && Store.page == 7: VerticalLayout {
                                spacing: 14px;
                                AboutBody { }
                                AboutInspector { }
                            }
                            if !root.searching && Store.page == 8: VerticalLayout {
                                spacing: 14px;
                                SystemInspector { }
                            }
                            if !root.searching && Store.page == 9: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Game downloads";
                                    sub: "Show the progress and speed of Steam and Epic Games downloads in the pill";
                                    glyph: "\u{E896}";
                                    checked <=> Store.games-downloads;
                                    toggled => { Ui.changed(); }
                                }
                                GamesInspector { }
                            }
                            if !root.searching && Store.page == 10: VerticalLayout {
                                spacing: 14px;
                                WellbeingBody { }
                                WellbeingInspector { }
                            }
                            if !root.searching && Store.page == 11: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Clipboard history";
                                    sub: "Keeps the last 20 copied items. Nothing is kept while it is off";
                                    glyph: "\u{E77F}";
                                    checked <=> Store.clipboard-stash;
                                    toggled => { Ui.changed(); }
                                }
                                Rectangle {
                                    opacity: Store.clipboard-stash ? 1 : 0.38;
                                    VerticalLayout {
                                        spacing: 14px;
                                        ClipboardInspector { }
                                    }
                                    if !Store.clipboard-stash: TouchArea { }
                                }
                            }
                            if !root.searching && Store.page == 12: VerticalLayout {
                                spacing: 14px;
                                PageHero {
                                    title: "Shelf";
                                    sub: "Drop files on the pill to hold them, then drag them out anywhere";
                                    glyph: "\u{E8F1}";
                                    checked <=> Store.shelf-on;
                                    toggled => { Ui.changed(); }
                                }
                                Rectangle {
                                    opacity: Store.shelf-on ? 1 : 0.38;
                                    VerticalLayout {
                                        spacing: 14px;
                                        ShelfInspector { }
                                        ShelfBody { }
                                    }
                                    if !Store.shelf-on: TouchArea { }
                                }
                            }
                            if !root.searching && Store.page == 14: VerticalLayout {
                                spacing: 14px;
                                EventsInspector { }
                            }
                        }
                    }
                }
            }
        }

        // Actions popup window
        actions := PopupWindow {
            x: 20px;
            y: root.height - 200px;
            width: 240px;
            close-policy: close-on-click-outside;
            Rectangle {
                border-radius: 10px;
                background: Theme.pop;
                border-width: 1px;
                border-color: Theme.pop-edge;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: Theme.pop-shadow;
                VerticalLayout {
                    padding: 6px;
                    ActionItem {
                        text: "Open settings file";
                        glyph: "\u{E8A5}";
                        clicked => { Store.action("file"); actions.close(); }
                    }
                    ActionItem {
                        text: "Open log";
                        glyph: "\u{E9F9}";
                        clicked => { Store.action("log"); actions.close(); }
                    }
                    ActionItem {
                        text: "Undo last removed";
                        glyph: "\u{E7A7}";
                        clicked => { Store.undo-remove(); actions.close(); }
                    }
                    ActionItem {
                        text: "Reset to defaults…";
                        glyph: "\u{E72C}";
                        danger: true;
                        clicked => { Ui.dialog = true; actions.close(); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ Reset to defaults confirmation
    if Ui.dialog: Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => { Ui.dialog = false; }
        }
        Rectangle {
            width: 380px;
            height: box.preferred-height;
            border-radius: 16px;
            background: Theme.pop;
            border-width: 1px;
            border-color: Theme.pop-edge;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.pop-shadow;
            TouchArea { }
            box := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text {
                    text: "Reset to defaults?";
                    font-size: 17px;
                    font-weight: 600;
                    color: Theme.strong;
                }
                Text {
                    text: "All settings will be restored to their original defaults. Followed teams, hidden apps, and exceptions will also be removed.";
                    font-size: 13.5px;
                    color: Theme.text2;
                    wrap: word-wrap;
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        width: 96px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.seg-on;
                        Text {
                            text: "Cancel";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Ui.dialog = false; }
                        }
                    }
                    Rectangle {
                        width: 96px;
                        height: 34px;
                        border-radius: 10px;
                        background: Tags.red.with-alpha(0.22);
                        Text {
                            text: "Reset";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.danger;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Ui.dialog = false;
                                Store.action("reset");
                            }
                        }
                    }
                }
            }
        }
    }

    if !Ui.maximized: ResizeEdges { }
}

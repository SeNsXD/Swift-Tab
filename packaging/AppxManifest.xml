<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="xdNOTLabs.SwiftTab"
            Publisher="CN=3E0B8872-1816-4AC8-A1B0-79459B17761E"
            Version="1.0.1.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Swift Tab</DisplayName>
    <PublisherDisplayName>xdNOTLabs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="SwiftTab" Executable="swifttab.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Swift Tab"
                          Description="A Dynamic-Island style pill for the Windows taskbar: media, earbuds battery, weather, clipboard and file shelf."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
    </Application>
    <Application Id="SwiftTabSettings" Executable="swifttab-settings.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Swift Tab Settings"
                          Description="Settings for Swift Tab"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
